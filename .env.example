# Copy to .env on the server and fill in. Never commit the real .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=erp.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.com

POSTGRES_DB=loyalgreen
POSTGRES_USER=loyalgreen
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db

# Domain Caddy gets the HTTPS certificate for
SITE_DOMAIN=erp.example.com
